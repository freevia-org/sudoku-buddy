<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network state is not needed for the explicit, one-shot report upload. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SudokuBuddy">
        <!--
          No fixed orientation. From Android 16 a locked one is ignored on large screens
          anyway, so the choice was never whether to support landscape - only whether to
          have looked at it first.

          The configuration changes are handled here rather than by a restart because the
          scan lives in memory: a recreated activity would drop the photograph and its
          reading, and the user would be back at the camera for turning the phone. The
          photograph is a bitmap of a size that has no business in a saved-state Bundle.
        -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.SudokuBuddy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Lets a photograph kept from a scan be handed to another app to send, one URI at
          a time and read-only. It grants nothing by itself: the receiving app is given
          permission to the exact files named in the share, and to nothing else.

          This provider only grants read-only access to selected scan files. Report
          submission uses the app's separate HTTPS client and INTERNET permission.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.scans"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
