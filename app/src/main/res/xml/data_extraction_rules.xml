<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone, including by being backed up off it.

  Some Android 12+ manufacturers allow device transfer despite allowBackup="false".
  Exclude each storage domain explicitly, including externally stored refused photos,
  to keep the behavior consistent with docs/privacy-policy.md.

  Device transfer is excluded as well as cloud backup. Carrying a puzzle history to a new
  phone would be a kindness, but it is a different promise from the one already made, and
  quietly widening where a user's photographs can travel is not a thing to do as a side
  effect of a lint warning.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
