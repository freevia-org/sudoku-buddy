<?xml version="1.0" encoding="utf-8"?>
<!--
  Saved puzzle photographs and refused scans can be shared explicitly. The provider
  grants access only to the individual URIs included in the user's share action.
-->
<paths>
    <!-- Photographs of scans that would not read. -->
    <external-files-path name="scans" path="Pictures/" />
    <!-- The same, when there is no external storage to write to. -->
    <files-path name="fallback-scans" path="scans/" />
    <!-- The straightened photograph of each saved puzzle. -->
    <files-path name="history" path="history/" />
</paths>
